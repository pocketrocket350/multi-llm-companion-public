tools/motion-converter/input/*.ZIP
tools/motion-converter/output/*.vmd
tools/motion-converter/output/*.VMD
tools/motion-converter/output/*.json
tools/motion-converter/runtime/

# 会話履歴データベース
data/*.db
data/*.db-*
data/*.sqlite
data/*.sqlite-*
data/*.sqlite3
data/*.sqlite3-*
data/**/*.db
data/**/*.db-*
data/**/*.sqlite
data/**/*.sqlite-*
data/**/*.sqlite3
data/**/*.sqlite3-*

# エディターとOSが作るファイル
