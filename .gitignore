*.py[cod]
*.egg-info/
build/
dist/

# テスト・静的解析ツールの一時ファイル
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# ローカル専用の秘密情報と設定
.env
local/

# 利用者が集めた配布素材は公開対象に含めない。
vmd_sample/

# QuickMagic FBX -> VMD conversion assets are local third-party/generated materials.
tools/motion-converter/input/*.fbx
tools/motion-converter/input/*.FBX
