#!/bin/sh
# 実メールを送る前に止める。検査の迂回はしない。
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd) || exit 1
if [ -x "$root/.venv/Scripts/python.exe" ]; then
    exec "$root/.venv/Scripts/python.exe" "$root/scripts/check_public_history.py" --pre-push
fi
exec python "$root/scripts/check_public_history.py" --pre-push
