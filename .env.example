# このファイルとコピー先の .env には、APIキーを書かないでください。
# APIキーはWindowsの環境変数へ設定します。
# setup_windows.bat が .env にコピーします。接続先やモデル名だけ .env 側で編集できます。

# APIを使わずに確認するMock用
MOCK_BASE_URL=mock://local
MOCK_MODEL=mock-model

# OpenAI用
OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY はWindowsの環境変数へ設定し、このファイルには書きません。
OPENAI_MODEL=

# Qwen用（公式資料で、契約したリージョンとWorkspace IDに合うURLを確認してください）
QWEN_BASE_URL=
# QWEN_API_KEY はWindowsの環境変数へ設定し、このファイルには書きません。
QWEN_MODEL=

# DeepSeek用
DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_API_KEY はWindowsの環境変数へ設定し、このファイルには書きません。
DEEPSEEK_MODEL=

# VoiSona Talkのユーザー名、API用パスワード、声名はWindowsの環境変数へ設定します。
# VOISONA_TALK_USERNAME、VOISONA_TALK_PASSWORD、VOISONA_TALK_VOICE_NAMEの値を
# このファイルへ書かないでください。
